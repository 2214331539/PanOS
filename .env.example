# Backend（放在 panos/backend/.env）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5440/panos
# 简约账号密码鉴权（V1 本地，目标仍 Supabase Auth）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=panos-dev
AUTH_SECRET=dev-secret-change-me
AUTH_TOKEN_TTL_SECONDS=86400
# 本地图片存储（V1 本地，目标仍 Supabase Storage）
UPLOAD_DIR=uploads
MEDIA_BASE_URL=http://localhost:8000/media
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_PUBLIC_BUCKET=panos-public-assets
SUPABASE_STORAGE_PRIVATE_BUCKET=panos-private-assets
CONTACT_RATE_LIMIT_SECRET=change-me
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

