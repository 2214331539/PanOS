# PanOS 后端环境变量模板。
# 用法：cp .env.example .env，然后填入真实值（.env 已被 .gitignore 忽略，不会入库）。
# 本地开发也可以直接运行 ./dev.sh，首次启动会自动生成 .env。

# ---- 必填：后台鉴权 ----
ADMIN_USERNAME=admin
# 强密码；生成示例：openssl rand -base64 18
ADMIN_PASSWORD=
# Token 签名密钥；生成示例：openssl rand -hex 32
AUTH_SECRET=
# 联系表单限流密钥；生成示例：openssl rand -hex 32
CONTACT_RATE_LIMIT_SECRET=

# ---- 可选：覆盖默认值（默认见 app/core/config.py）----
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5440/panos
# MEDIA_BASE_URL=http://localhost:8000/media
# BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 本地开发可放开任意 localhost 端口（Vite 端口会自动顺延）；生产环境不要设置此项
# BACKEND_CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
